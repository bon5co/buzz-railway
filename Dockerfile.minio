# Object storage for Buzz, packaged for Railway.
#
# This is where every git object and every uploaded file actually lives: Buzz
# keeps no authoritative repository state on local disk, so the relay hydrates
# an ephemeral working tree from here on each request (upstream:
# docs/git-on-object-storage.md). Which is why the template mounts a volume on
# THIS service -- an object store without one loses every repo and attachment on
# each redeploy, while the chat history in Postgres survives, so the workspace
# comes back looking intact with every clone and every image broken.
FROM minio/minio:RELEASE.2025-09-07T16-13-09Z

ENV MINIO_ROOT_USER=buzz \
    MINIO_BROWSER=off \
    BUZZ_S3_BUCKET=buzz-media \
    PORT=9000

COPY minio-boot.sh /usr/local/bin/minio-boot
RUN chmod 0755 /usr/local/bin/minio-boot

EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/minio-boot"]
